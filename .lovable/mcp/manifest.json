{
  "version": 1,
  "sdk_version": "3.0.4",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://njwsoeczrximubnycenc.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "dermaspa-clarity",
      "version": "0.1.0",
      "title": "DermaSpa Clarity"
    },
    "tools": [
      {
        "name": "get_context",
        "title": "Get context",
        "description": "Today's date in Vancouver, how recent the loaded data is, locations, active providers, service groups, and which KPIs lack data and why. Call this first.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "get_scorecard",
        "title": "Get scorecard",
        "description": "The 10 clinic scorecard KPIs plus extra metrics for a date range: current value, comparison, % change, target, status and notes.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "start_date": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "Date as YYYY-MM-DD"
            },
            "end_date": {
              "$ref": "#/properties/start_date"
            },
            "location": {
              "type": "string",
              "enum": [
                "Derma Spa Oak Bay",
                "Derma Spa Uptown",
                "Derma Spa Nanaimo"
              ],
              "description": "Filter to one location; omit for all."
            },
            "provider": {
              "type": "string",
              "description": "Provider name exactly as listed by get_context; omit for all."
            },
            "compare_to": {
              "type": "string",
              "enum": [
                "previous",
                "last_year"
              ],
              "default": "previous",
              "description": "Compare with previous period of same length or same period last year."
            }
          },
          "required": [
            "start_date",
            "end_date"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_kpi_trend",
        "title": "Get KPI trend",
        "description": "Monthly values of one KPI over the last N months.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "kpi": {
              "type": "string",
              "enum": [
                "revenue",
                "adjusted_ebitda_pct",
                "new_patients",
                "cac",
                "ltv_12m",
                "ltv_cac",
                "second_visit_rate_90d",
                "retention_12m",
                "revenue_per_provider_hour",
                "provider_utilization_pct",
                "collected_revenue",
                "visits",
                "unique_patients",
                "avg_revenue_per_visit",
                "no_show_rate",
                "late_cancel_rate",
                "neuromodulator_units_per_visit"
              ],
              "description": "KPI code"
            },
            "months": {
              "type": "integer",
              "minimum": 1,
              "maximum": 36,
              "default": 12
            },
            "location": {
              "type": "string",
              "enum": [
                "Derma Spa Oak Bay",
                "Derma Spa Uptown",
                "Derma Spa Nanaimo"
              ],
              "description": "Filter to one location; omit for all."
            },
            "provider": {
              "type": "string",
              "description": "Provider name exactly as listed by get_context; omit for all."
            }
          },
          "required": [
            "kpi"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_revenue_breakdown",
        "title": "Get revenue breakdown",
        "description": "Revenue (ex-tax) for a date range split by location, service group, income category, provider or item, with quantity and % of total.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "start_date": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "Date as YYYY-MM-DD"
            },
            "end_date": {
              "$ref": "#/properties/start_date"
            },
            "group_by": {
              "type": "string",
              "enum": [
                "location",
                "service_group",
                "income_category",
                "provider",
                "item"
              ]
            },
            "location": {
              "type": "string",
              "enum": [
                "Derma Spa Oak Bay",
                "Derma Spa Uptown",
                "Derma Spa Nanaimo"
              ],
              "description": "Filter to one location; omit for all."
            },
            "provider": {
              "type": "string",
              "description": "Provider name exactly as listed by get_context; omit for all."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 15
            }
          },
          "required": [
            "start_date",
            "end_date",
            "group_by"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_provider_performance",
        "title": "Get provider performance",
        "description": "Per-provider revenue, visits, hours, revenue per hour, utilization, new patients and no-show rate for a date range.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "start_date": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "Date as YYYY-MM-DD"
            },
            "end_date": {
              "$ref": "#/properties/start_date"
            },
            "location": {
              "type": "string",
              "enum": [
                "Derma Spa Oak Bay",
                "Derma Spa Uptown",
                "Derma Spa Nanaimo"
              ],
              "description": "Filter to one location; omit for all."
            }
          },
          "required": [
            "start_date",
            "end_date"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_retention_cohorts",
        "title": "Get retention cohorts",
        "description": "For each first-visit month, % of new patients who returned within 1–12 months, and revenue per patient.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "months": {
              "type": "integer",
              "minimum": 1,
              "maximum": 36,
              "default": 12
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "explain_kpi",
        "title": "Explain KPI",
        "description": "Definition, formula and data sources for a KPI.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "kpi": {
              "type": "string",
              "enum": [
                "revenue",
                "adjusted_ebitda_pct",
                "new_patients",
                "cac",
                "ltv_12m",
                "ltv_cac",
                "second_visit_rate_90d",
                "retention_12m",
                "revenue_per_provider_hour",
                "provider_utilization_pct",
                "collected_revenue",
                "visits",
                "unique_patients",
                "avg_revenue_per_visit",
                "no_show_rate",
                "late_cancel_rate",
                "neuromodulator_units_per_visit"
              ]
            }
          },
          "required": [
            "kpi"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}
